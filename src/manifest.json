{
  "manifest_version": 2,
  "name": "Inkference",
  "version": "0.7.0",
  "description": "AI dark mode, a page-aware sidebar agent and read-aloud, powered by your own local models via lmgw",
  "homepage_url": "https://github.com/lmgw-dev/inkference",

  "browser_specific_settings": {
    "gecko": {
      "id": "inkference@lmgw-dev",
      "strict_min_version": "115.0"
    }
  },

  "background": {
    "page": "background/background.html",
    "persistent": true
  },

  "sidebar_action": {
    "default_title": "Inkference",
    "default_panel": "sidebar/sidebar.html",
    "browser_style": false,
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
  },

  "browser_action": {
    "default_title": "Inkference dark mode — click: toggle · right-click: recompile / forget",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
  },

  "page_action": {
    "default_title": "Inkference script",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png" }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "commands": {
    "_execute_sidebar_action": {
      "suggested_key": { "default": "Ctrl+Shift+L" }
    },
    "toggle-cheat-hud": {
      "suggested_key": { "default": "Ctrl+Shift+G" },
      "description": "Toggle the Cheat Lab HUD on the current page"
    }
  },

  "permissions": [
    "tabs",
    "activeTab",
    "menus",
    "storage",
    "notifications",
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "http://127.0.0.1:8001/*",
    "<all_urls>"
  ],

  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" }
}
