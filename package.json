{
  "name": "rsd-firefox",
  "version": "0.6.0",
  "type": "module",
  "private": true,
  "description": "Page-aware LLM sidebar + right-click actions for the lmgw gateway (Firefox MV2)",
  "license": "MIT",
  "homepage": "https://github.com/lmgw-dev/rsd-firefox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lmgw-dev/rsd-firefox.git"
  },
  "scripts": {
    "vendor": "esbuild @mozilla/readability --bundle --format=iife --global-name=Readability --outfile=src/vendor/readability.js && esbuild marked --bundle --format=esm --outfile=src/vendor/marked.js && esbuild dompurify --bundle --format=esm --outfile=src/vendor/dompurify.js",
    "dev": "web-ext run --source-dir=src",
    "mock": "node mock/server.mjs",
    "lint": "web-ext lint --source-dir=src",
    "build": "web-ext build --source-dir=src --artifacts-dir=dist --overwrite-dest",
    "sign": "web-ext sign --channel=unlisted --source-dir=src --artifacts-dir=dist",
    "ground-check": "node tools/ground-check.mjs",
    "dark-check": "node tools/dark-check.mjs",
    "script-check": "node tools/script-check.mjs",
    "script-e2e": "node tools/script-e2e.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "web-ext": "^8.4.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "dompurify": "^3.1.0",
    "marked": "^14.1.0"
  }
}
